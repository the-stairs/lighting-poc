{
  "name": "lighting-poc",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 ELECTRON_RUN_AS_NODE= electron .",
    "build": "vite build",
    "preview": "vite preview",
    "relay": "node relay/index.js",
    "electron": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "p5": "^1.9.2",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-stairs/lighting-poc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/the-stairs/lighting-poc/issues"
  },
  "homepage": "https://github.com/the-stairs/lighting-poc#readme",
  "description": "Lighting POC desktop app",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5"
  }
}
